{
  "name": "sightline",
  "version": "0.0.1",
  "private": true,
  "description": "A first-person stealth-sniper game.",
  "type": "module",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.kernel.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:browser": "vitest run --config vitest.browser.config.ts",
    "sim": "tsx src/headless/cli.ts",
    "seeds": "tsx src/headless/seeds.ts",
    "selftest": "tsx src/headless/selftest.ts",
    "check": "npm run typecheck && npm run test",
    "golden": "tsx src/headless/golden.ts",
    "bench": "tsx src/headless/bench.ts",
    "trace": "tsx src/headless/trace.ts",
    "explain": "tsx src/headless/explain.ts",
    "land": "tsx src/headless/land.ts",
    "scene": "tsx src/headless/scene.ts",
    "fuzz": "tsx src/headless/fuzz.ts",
    "playtest": "tsx src/headless/playtest.ts",
    "look": "tsx src/headless/look.ts"
  },
  "dependencies": {
    "three": "0.186.1"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "@types/three": "0.186.0",
    "@vitest/browser-playwright": "5.0.5",
    "playwright": "1.63.0",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  }
}
